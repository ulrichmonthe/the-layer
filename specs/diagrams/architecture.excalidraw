      "roundness": null,
      "seed": 1015,
      "version": 1,
      "versionNonce": 1015,
      "text": "packages/workflow \u2014 opportunities \u00b7 applications \u00b7 commitments \u00b7 awards \u00b7\nreports \u00b7 tasks \u00b7 approvals \u00b7 the nudge engine (push, not pull).\nDeadlines, amounts and commitments are stored records \u2014 never LLM output.",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "packages/workflow \u2014 opportunities \u00b7 applications \u00b7 commitments \u00b7 awards \u00b7\nreports \u00b7 tasks \u00b7 approvals \u00b7 the nudge engine (push, not pull).\nDeadlines, amounts and commitments are stored records \u2014 never LLM output.",
      "lineHeight": 1.25,
      "autoResize": true
    },
