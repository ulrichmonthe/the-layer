      "seed": 1018,
      "version": 1,
      "versionNonce": 1018,
      "text": "packages/reasoning\n   match       org profile \u00d7 funder            \u2192 FitAssessment\n   draft       question set \u00d7 corpus           \u2192 attributed narrative\n   translate   org budget \u00d7 funder template    \u2192 mapping, delta must = 0\n   triage      history \u00d7 pipeline              \u2192 expected value",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
