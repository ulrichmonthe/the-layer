      "version": 1,
      "versionNonce": 1011,
      "text": "apps/web \u2014 Next.js App Router, server components by default.\nConversation in, document artifacts out. Renders approval gates and\nclaim-level provenance popovers. Contains no business logic.",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "apps/web \u2014 Next.js App Router, server components by default.\nConversation in, document artifacts out. Renders approval gates and\nclaim-level provenance popovers. Contains no business logic.",
      "lineHeight": 1.25,
      "autoResize": true
    },
