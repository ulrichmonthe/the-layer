      "seed": 1051,
      "version": 1,
      "versionNonce": 1051,
      "text": "Nothing leaves the organisation \u2014\nemail, submission, final export \u2014\nwithout a granted approvals row.\nEnforced server-side, not in the UI.\nOtherwise \u2192 APPROVAL_REQUIRED",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "left",
