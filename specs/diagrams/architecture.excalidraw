      "roundness": null,
      "seed": 1054,
      "version": 1,
      "versionNonce": 1054,
      "text": "A draft cannot reach 'accepted' while\nany claim has empty fact_ids.\nServer-side check plus a blocking\nattribution eval in CI.\nOtherwise \u2192 PROVENANCE_VIOLATION\n\nStyle text is exempt; anything\ncheckable is a claim.",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "A draft cannot reach 'accepted' while\nany claim has empty fact_ids.\nServer-side check plus a blocking\nattribution eval in CI.\nOtherwise \u2192 PROVENANCE_VIOLATION\n\nStyle text is exempt; anything\ncheckable is a claim.",
      "lineHeight": 1.25,
      "autoResize": true
    },
